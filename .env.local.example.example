# Copiá este archivo a ".env.local" (sin ".example") y completá con tus
# datos reales de Supabase (Project Settings -> API en el panel de Supabase).
# .env.local NUNCA se sube a GitHub (ya esta en .gitignore).
# En Vercel, estas mismas dos variables se configuran en Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica
